rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Rules for 'users' collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth.uid == userId;
    }

    // Rules for 'rooms' collection
    match /rooms/{roomId} {
      allow list: if request.auth != null;
      allow get: if request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth.uid in resource.data.adminIds;
      allow delete: if request.auth.uid == resource.data.ownerId;

      // --- Rules for ALL subcollections ---
      match /tasks/{taskId} {
        allow read, write: if request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberIds;
      }
      match /phases/{phaseId} {
        allow read, write: if request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberIds;
      }
      match /chat/{messageId} {
        allow read, create: if request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberIds;
      }
      match /activity/{activityId} {
        allow read, create: if request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberIds;
      }
      match /testSuites/{suiteId} {
        allow read, write: if request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberIds;
      }
      match /testCases/{caseId} {
        allow read, write: if request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberIds;
      }
      match /issues/{issueId} {
        allow read, write: if request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberIds;
      }
      match /deployments/{deploymentId} {
        allow read, create: if request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberIds;
      }
      match /configs/{configId} {
        allow read, write: if request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberIds;
      }
    }

    // Rule for the top-level 'deploymentRequests' collection
    match /deploymentRequests/{requestId} {
      allow read: if request.auth != null && requestId.endsWith('_' + request.auth.uid);
      allow write: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Rules for 'calls' and 'signaling'
    match /calls/{callId} {
      allow create: if request.auth.uid in request.resource.data.participants;
      allow read, update, delete: if request.auth.uid in resource.data.participants;

      match /signaling/{messageId} {
        allow read, create, delete: if request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.participants;
      }
    }
  }
}